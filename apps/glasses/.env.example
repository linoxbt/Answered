# Glasses app build settings. URLs only: no secrets ever go in the app bundle.
# Copy to .env.local for development, .env.production for `pnpm pack`.
VITE_WS_URL=ws://localhost:8787/ws/glasses
# Deployed server: wss://server-production-f558e8c1.up.railway.app/ws/glasses
# Phase 0 only: must equal the server's GLASSES_DEV_TOKEN. Pairing (phase 5) replaces it.
VITE_DEV_HOST_TOKEN=dev
