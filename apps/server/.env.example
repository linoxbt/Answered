# Copy to apps/server/.env (never committed). Phases in brackets say when each value is first needed.

# [0] Server
PORT=8787
PUBLIC_URL=https://api.answered.app
CORS_ORIGIN=*
LOG_LEVEL=info

# [0] Telegram (BotFather). Secret: 1-256 chars of A-Z a-z 0-9 _ -
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=
TG_BOT_USERNAME=AnsweredHQBot

# [0] Glasses socket token until pairing lands in phase 5. Must match the glasses' VITE_DEV_HOST_TOKEN.
GLASSES_DEV_TOKEN=dev

# [1] Database
DATABASE_URL=file:./answered.db

# [2] Question pipeline. Without a key, a keyword heuristic classifies (fine for testing, weak at merging).
ANTHROPIC_API_KEY=
LLM_CLASSIFY_MODEL=claude-haiku-5-5
CLASSIFY_BATCH_MS=2000

# [4] Answer judge (uses ANTHROPIC_API_KEY) and the undo window before a reply is posted
LLM_JUDGE_MODEL=claude-sonnet-5-5
UNDO_MS=3000

# [3] Speech. Without a key, glasses audio is counted but not transcribed.
DEEPGRAM_API_KEY=
# Words Deepgram should expect (one keyterm each): project name, ticker, product names.
STT_KEYTERMS=mainnet,testnet,tokenomics,airdrop
