# Copy to apps/server/.env (never committed). Phases in brackets say when each value is first needed.

# [0] Server
PORT=8787
PUBLIC_URL=https://api.answered.app
CORS_ORIGIN=*
LOG_LEVEL=info

# [0] Telegram (BotFather). Secret: 1-256 chars of A-Z a-z 0-9 _ -
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=
TG_BOT_USERNAME=AnsweredHQBot

# [0] Glasses socket token until pairing lands in phase 5. Must match the glasses' VITE_DEV_HOST_TOKEN.
GLASSES_DEV_TOKEN=dev

# [1] Database
DATABASE_URL=file:./answered.db

# [2] Question pipeline
ANTHROPIC_API_KEY=
LLM_CLASSIFY_MODEL=claude-haiku-5-5
LLM_JUDGE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
THRESH_JOIN=0.82
THRESH_NEW=0.74

# [3] Speech
DEEPGRAM_API_KEY=

# [4] Answer matcher
THRESH_GATE=0.50
THRESH_JUDGE=0.75
