{
  "name": "@answered/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "set-webhook": "tsx --env-file-if-exists=.env scripts/set-webhook.ts",
    "ws-smoke": "tsx --env-file-if-exists=.env scripts/ws-smoke.ts",
    "eval:clusters": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --env-file-if-exists=.env scripts/eval-clusters.ts",
    "replay-audio": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --env-file-if-exists=.env scripts/replay-audio.ts",
    "eval:answers": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --env-file-if-exists=.env scripts/eval-answers.ts",
    "host-sim": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --env-file-if-exists=.env scripts/host-sim.ts",
    "scorecard": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --env-file-if-exists=.env scripts/scorecard.ts"
  },
  "dependencies": {
    "@answered/protocol": "workspace:*",
    "@anthropic-ai/sdk": "^1.14.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "grammy": "^1.48.0",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "ws": "^8.23.0"
  }
}
