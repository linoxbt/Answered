# From https://my.telegram.org > API development tools (one app is enough for all accounts).
TG_API_ID=
TG_API_HASH=
# One session string per audience account, from `pnpm --filter @answered/seed login`, comma-separated.
# These log in as those accounts: never commit them.
TG_SESSIONS=
# The group: @username, a t.me link, or its exact title as it appears in the accounts' chat lists.
SEED_CHAT=super group
